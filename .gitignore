# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# API keys/service-account credentials (ASC key, Google Play service
# account, etc.) -- the whole directory, not just specific extensions,
# since a .json service-account key wasn't covered by any rule above.
/credentials/

# Metro
.metro-health-check*

# Store submission build artifacts (large binaries already hosted on EAS)
*.aab
*.ipa

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Claude Code session/runtime state (not project config)
.claude/scheduled_tasks.lock

# Supabase CLI local link/session state
supabase/.temp
supabase/.branches

.vercel
.env*
