{
  "expo": {
    "name": "FitNFree",
    "slug": "FitNFree",
    "version": "1.0.0",
    "scheme": "fitnfree",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamk.fitnfree",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitnfree.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitNFree uses your photos to identify gym equipment from a picture.",
          "cameraPermission": "FitNFree uses your camera to identify gym equipment from a photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitNFree uses your camera to scan food barcodes and restaurant menus.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitNFree uses your microphone to hear voice commands to your AI Coach.",
          "speechRecognitionPermission": "FitNFree uses speech recognition to turn your voice into text for your AI Coach."
        }
      ],
      "expo-sharing",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitNFree uses your location to track outdoor activities like runs, walks, and rides.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withoutPushEntitlement.js",
      [
        "expo-notifications",
        {
          "color": "#a3e635"
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5d7afbfb-4304-4d69-907f-8184b8dd0872"
      },
      "privacyPolicyUrl": "https://delix-k.github.io/apps/fitnfree/privacy.html",
      "termsUrl": "https://delix-k.github.io/apps/fitnfree/terms.html",
      "supportUrl": "https://delix-k.github.io/apps/"
    },
    "owner": "team_k"
  }
}
