{
  "expo": {
    "name": "FitNFree",
    "slug": "FitNFree",
    "version": "1.0.0",
    "scheme": "fitnfree",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamk.fitnfree",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "FitNFree uses speech recognition to turn your voice into text for your AI Coach.",
        "NSMicrophoneUsageDescription": "FitNFree uses your microphone for voice commands to your AI Coach and when you record videos."
      }
    },
    "android": {
      "package": "com.teamk.fitnfree",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitNFree uses your photo library so you can choose photos and videos for equipment, meal and menu scans, form checks and trainer profiles.",
          "cameraPermission": "FitNFree uses your camera to scan gym equipment, food barcodes, meals and restaurant menus, and to record form-check and trainer videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitNFree uses your camera to scan gym equipment, food barcodes, meals and restaurant menus, and to record form-check and trainer videos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitNFree uses your microphone for voice commands to your AI Coach and when you record videos.",
          "speechRecognitionPermission": "FitNFree uses speech recognition to turn your voice into text for your AI Coach."
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitNFree uses your location to track outdoor activities like runs, walks, and rides.",
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "./plugins/withoutPushEntitlement.js",
      [
        "expo-notifications",
        {
          "color": "#a3e635"
        }
      ],
      "expo-video",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://delix-k.github.io/apps/fitnfree/privacy.html",
      "termsUrl": "https://delix-k.github.io/apps/fitnfree/terms.html",
      "supportUrl": "https://delix-k.github.io/apps/",
      "eas": {
        "projectId": "f3710caa-723a-45cc-be8d-dbd29127a81a"
      }
    },
    "owner": "team_k"
  }
}
